---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import { sourceById } from '../../lib/meta';
import {
  sortCandidates, partyAbbr, partyRuleClass, initials,
  formatDate, formatShort, orElse, NOT_PUBLISHED, NOT_STATED, NO_WEBSITE,
} from '../../lib/derive';

export async function getStaticPaths() {
  const races = await getCollection('races');
  return races.map((race) => ({ params: { id: race.id }, props: { race } }));
}

const { race } = Astro.props;
const r = race.data;
const candidates = sortCandidates(r.candidates);
const source = sourceById(r.source);

/* "Seat" in the facts strip means: is an incumbent running. Different fact
   from the seat NUMBER in the badge above. Same word, two meanings —
   flagged in the README as worth relabelling. */
const incumbentRunning = candidates.some((c) => c.incumbent);
const seatFact = incumbentRunning ? 'Incumbent running' : 'Open seat';

/* Numbered seats get the big-number badge; named ones get a plain label. */
const seatMatch = r.seat.match(/^(Seat|District|Group)\s+(\d+)$/);

const facts = [
  { label: 'County', value: r.county },
  { label: 'Election', value: `${formatShort(r.electionDate)} ${r.electionDate === '2026-11-03' ? 'general' : 'primary'}` },
  { label: 'Field', value: `${candidates.length} ${candidates.length === 1 ? 'candidate' : 'candidates'}` },
  { label: 'Seat', value: seatFact },
];

/* Absent values print in the record's own words. Never a blank cell. */
function proofRows(c: typeof candidates[number]) {
  const rows: { label: string; value: string; href?: string | null }[] = [
    { label: 'Filed', value: orElse(formatDate(c.qualified), NOT_PUBLISHED) },
    { label: 'Qualifying method', value: orElse(c.qualifyingMethod) },
    { label: 'Petition met', value: orElse(formatDate(c.petitionMet)) },
    { label: 'Treasurer', value: orElse(c.treasurer) },
    { label: 'Treasurer filed', value: orElse(formatDate(c.treasurerFiled)) },
  ];
  // Only the Governor ticket has running mates; don't show the row elsewhere.
  if (c.runningMate !== undefined) {
    rows.push({ label: 'Running mate', value: orElse(c.runningMate, 'Not named') });
  }
  rows.push(
    { label: 'Email', value: orElse(c.email) },
    { label: 'Phone', value: orElse(c.phone) },
    { label: 'Campaign website', value: c.website ?? NO_WEBSITE, href: c.website },
    { label: 'Campaign finance', value: c.financeUrl ? 'Official finance record' : NOT_PUBLISHED, href: c.financeUrl },
  );
  return rows;
}
---
<Base title={r.office} description={r.ballotNote}>
  <div class="shell">
    <div class="pt-5">
      <a href="/" class="text-meta font-semibold text-accent-700 underline">← All races</a>
    </div>

    <header class="border-b-2 border-divider pb-6 pt-6">
      <div class="text-label text-accent-700">{r.county} County · {r.level}</div>
      <h1 class="mt-2.5 max-w-[22ch] text-title">{r.office}</h1>

      <!-- Seat sits BELOW the title, paired with the jurisdiction. Beside the
           h1 it competed for the same baseline and forced early wrapping. -->
      <div class="mt-3.5 flex flex-wrap items-center gap-x-3.5 gap-y-2.5">
        {seatMatch ? (
          <span class="inline-flex items-baseline gap-2 whitespace-nowrap border-2 border-ink px-3 py-[5px]">
            <span class="text-meta text-neutral-700">{seatMatch[1]}</span>
            <span class="font-heading text-[20px] leading-none tracking-[-0.02em]">{seatMatch[2]}</span>
          </span>
        ) : (
          <span class="inline-flex items-center whitespace-nowrap border-2 border-ink px-3 py-1.5 text-meta text-neutral-700">{r.seat}</span>
        )}
        <span class="text-body text-neutral-700">{r.jurisdiction}</span>
      </div>
    </header>

    <!-- Facts strip. Rules are border-top per cell (not verticals) so a
         wrapped second row still gets a rule and none dangles at an edge.
         The wrapper clips the trailing edge; the -26px pull keeps cell one
         flush with the h1. -->
    <div class="overflow-hidden">
      <div
        class="grid gap-y-0"
        style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-left:-26px;margin-top:-1px;width:calc(100% + 27px)"
      >
        {facts.map((f) => (
          <div class="border-t-2 border-divider px-[26px] py-5">
            <div class="text-label text-neutral-700">{f.label}</div>
            <div class="mt-[7px] text-[17px] font-extrabold">{f.value}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-wrap gap-x-12 gap-y-10 pb-16 pt-10">
      <div class="min-w-0 flex-[999_1_440px]">
        <div class="bg-accent-100 p-5" style="border-left:4px solid var(--color-accent)">
          <div class="text-label text-neutral-700">How this seat is decided</div>
          <p class="mt-2 max-w-[54ch] text-dense">{r.ballotNote}</p>
        </div>

        <h2 class="mt-10 text-section">Everyone still running</h2>
        <p class="mt-1.5 text-meta text-neutral-700">Listed alphabetically by last name.</p>

        <div class="mt-5 divide-y-2 divide-divider border-t-2 border-divider">
          {candidates.map((c) => (
            <article class={`py-7 ${partyRuleClass(c.party)}`}>
              <div class="flex flex-wrap items-start gap-4">
                <span class="grid size-14 shrink-0 place-items-center bg-surface font-heading text-[17px]" aria-hidden="true">
                  {initials(c.name)}
                </span>
                <div class="min-w-0 flex-1">
                  <h3 class="text-name">{c.name}</h3>
                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                    <span class="text-meta text-neutral-700">{partyAbbr(c.party)}</span>
                    {c.incumbent && <span class="border-2 border-ink px-2 py-0.5 text-micro font-semibold">Incumbent</span>}
                    {c.withdrew && <span class="border-2 border-ink px-2 py-0.5 text-micro font-semibold">Withdrew {formatShort(c.withdrew)}</span>}
                  </div>
                  {c.note && <p class="mt-2.5 max-w-[54ch] text-value text-neutral-800">{c.note}</p>}
                </div>
              </div>

              <!-- The proof block: the paperwork that shows this candidate
                   really filed. Every absent value names whose gap it is. -->
              <dl class="mt-5 grid gap-x-8 gap-y-3.5" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
                {proofRows(c).map((row) => (
                  <div>
                    <dt class="text-label text-neutral-700">{row.label}</dt>
                    <dd class="mt-0.5 text-value">
                      {row.href
                        ? <a href={row.href} target="_blank" rel="noopener">{row.value} <Icon name="lucide:arrow-up-right" width={13} height={13} class="inline align-baseline" /></a>
                        : row.value}
                    </dd>
                  </div>
                ))}
              </dl>

              <p class="mt-4 text-label">
                <a href={c.recordUrl} target="_blank" rel="noopener">
                  Official record for {c.name} <Icon name="lucide:arrow-up-right" width={13} height={13} class="inline align-baseline" />
                </a>
              </p>
            </article>
          ))}
        </div>
      </div>

      <aside class="flex-[1_1_300px]">
        <div class="border-2 border-ink p-5">
          <div class="text-label text-neutral-700">Currently holds this seat</div>
          <div class="mt-1.5 text-name">{orElse(r.heldBy.name, NOT_PUBLISHED)}</div>
          <div class="mt-1 text-meta text-neutral-700">{orElse(r.heldBy.party, NOT_STATED)}</div>
        </div>

        {r.pending && (
          <div class="mt-5 border-2 border-divider p-5">
            <div class="text-label text-neutral-700">Still changing</div>
            <p class="mt-2 text-value">{r.pending}</p>
          </div>
        )}

        {source && (
          <p class="mt-5 text-label">
            <a href={source.url} target="_blank" rel="noopener">
              {source.label} <Icon name="lucide:arrow-up-right" width={13} height={13} class="inline align-baseline" />
            </a>
          </p>
        )}
      </aside>
    </div>
  </div>
</Base>
