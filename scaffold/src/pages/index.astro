---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import RaceCard from '../components/RaceCard.astro';
import { meta, regions } from '../lib/meta';
import { LEVELS } from '../content.config';
import { deadlineState, formatShort } from '../lib/derive';

const entries = await getCollection('races');
const totalCandidates = entries.reduce((n, e) => n + e.data.candidates.length, 0);

/* Group by level in the canonical order, not data order. */
const byLevel = LEVELS
  .map((level) => ({ level, races: entries.filter((e) => e.data.level === level) }))
  .filter((g) => g.races.length);

const primary = deadlineState(meta.elections.primary.date);

/* Filter groups are derived from the data and from meta — never a hardcoded
   county name. Adding a region adds its chip automatically. */
const filterGroups = [
  { id: 'county', label: 'County', options: regions.map((r) => r.id) },
  { id: 'level', label: 'Race level', options: byLevel.map((g) => g.level) },
  { id: 'party', label: 'Party', options: ['Democrat', 'Republican', 'No Party Affiliation', 'Libertarian', 'Write-In', 'Not stated'] },
];
---
<Base title="Every race on your ballot">
  <div class="shell">
    <!-- Masthead -->
    <div class="flex flex-wrap gap-x-16 gap-y-10 py-14">
      <div class="min-w-0 flex-[999_1_440px]">
        <div class="text-label font-semibold text-accent-700">{meta.kicker}</div>
        <h1 class="mt-2.5 max-w-[20ch] text-hero">Everyone on your ballot. Nothing else.</h1>
        <p class="mt-5 max-w-[48ch] text-body text-ink">{meta.intro}</p>
      </div>

      <div class="flex-[1_1_320px] self-end">
        <div class="grid grid-cols-2 gap-x-8 gap-y-6 border-t-2 border-divider pt-6">
          <div>
            <div class="text-label text-neutral-700">{meta.elections.primary.label}</div>
            <div class="mt-1.5 font-heading text-stat">{meta.elections.primary.short}</div>
            <!-- Derived from the clock on every load, never a stored string. -->
            <div class="mt-1.5 text-meta font-semibold text-accent-700">{primary.label}</div>
          </div>
          <div>
            <div class="text-label text-neutral-700">{meta.elections.general.label}</div>
            <div class="mt-1.5 font-heading text-stat">{meta.elections.general.short}</div>
            <div class="mt-1.5 text-meta text-neutral-700">{meta.elections.general.note}</div>
          </div>
          <div class="border-t-2 border-divider pt-4">
            <div class="text-label text-neutral-700">{meta.elections.earlyVoting.label}</div>
            <div class="mt-1 text-dense font-semibold">{meta.elections.earlyVoting.short}</div>
          </div>
          <div class="border-t-2 border-divider pt-4">
            <div class="text-label text-neutral-700">On this page</div>
            <div class="mt-1 text-dense font-semibold">{entries.length} races · {totalCandidates} candidates</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Body: filter rail + results -->
    <div class="flex flex-wrap gap-x-10 border-t-2 border-divider">
      <aside class="flex-[1_1_210px] py-7" aria-label="Filters">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-[15px] font-extrabold">Filter</h2>
          <button type="button" id="clear-filters" hidden class="border-0 bg-transparent p-0 text-label font-semibold text-accent-700 underline">Clear all</button>
        </div>
        {filterGroups.map((g) => (
          <div class="mt-6" data-filter-group={g.id}>
            <div class="text-micro font-semibold text-neutral-700">{g.label}</div>
            <div class="mt-2.5 flex flex-wrap gap-2">
              {g.options.map((o) => (
                <button type="button" class="chip" aria-pressed="false" data-value={o}>{o}</button>
              ))}
            </div>
          </div>
        ))}
      </aside>

      <div class="min-w-0 flex-[999_1_440px] py-7 pl-[clamp(0px,3vw,32px)]">
        <div class="relative flex items-center">
          <Icon
            name="lucide:search"
            width={18} height={18}
            class="pointer-events-none absolute left-3.5"
            style="color:color-mix(in srgb,var(--color-ink) 55%,transparent)"
            aria-hidden="true"
          />
          <input
            type="search" id="q"
            aria-label="Search races and candidates"
            placeholder="Search a name, an office, a district…"
            class="w-full border-2 border-ink bg-transparent py-2 pl-[42px] pr-3.5 text-[16px]"
            style="min-height:48px"
          />
        </div>

        <div class="flex items-baseline justify-between gap-4 border-b-2 border-divider py-4">
          <span id="result-line" class="text-meta text-neutral-700">Showing all {entries.length} races</span>
          <span class="text-meta text-neutral-700">Verified {formatShort(meta.lastVerified)}</span>
        </div>

        <!-- Every race is rendered server-side and filtered by hiding, so the
             full list is indexable and works with JS off. Do not build this
             list from JS. -->
        {byLevel.map((g) => (
          <section data-level-group={g.level}>
            <h2 class="mt-9 border-b-2 border-divider pb-2.5 text-meta font-semibold text-accent-700">{g.level}</h2>
            <div class="divide-y-2 divide-divider">
              {g.races.map((race) => <RaceCard race={race} />)}
            </div>
          </section>
        ))}

        <!-- Empty state. When the query names an off-cycle office, answer it
             directly and suppress the generic line — see derive.offCycleAnswer.
             Populated client-side from the JSON below. -->
        <div id="empty" hidden class="py-12">
          <p id="empty-specific" hidden class="max-w-[46ch]">
            <strong id="empty-heading" class="block text-section"></strong>
            <span id="empty-note" class="mt-3 block text-body text-neutral-800"></span>
          </p>
          <p id="empty-generic" class="text-body text-neutral-800">No races match those filters.</p>
        </div>
      </div>
    </div>
  </div>

  <script
    type="application/json"
    id="off-cycle"
    set:html={JSON.stringify(meta.notUpThisCycle)}
  />

  <script>
    /* Filtering is a class toggle over pre-rendered cards. At 52 races and
       135 candidates this is instant; no debounce, no framework, no fetch. */
    const q = document.getElementById('q');
    const cards = [...document.querySelectorAll('[data-race]')];
    const groups = [...document.querySelectorAll('[data-filter-group]')];
    const resultLine = document.getElementById('result-line');
    const clearBtn = document.getElementById('clear-filters');
    const empty = document.getElementById('empty');
    const offCycle = JSON.parse(document.getElementById('off-cycle').textContent);

    const active = {};
    groups.forEach((g) => (active[g.dataset.filterGroup] = new Set()));

    function matches(card) {
      const needle = q.value.trim().toLowerCase();
      if (needle && !card.dataset.search.includes(needle)) return false;
      for (const [id, set] of Object.entries(active)) {
        if (!set.size) continue;                      // AND across groups
        const field =
          id === 'county' ? (card.dataset.counties || '').split('|')
          : id === 'level' ? [card.dataset.level]
          : (card.dataset.parties || '').split('|');
        if (![...set].some((v) => field.includes(v))) return false;  // OR within
      }
      return true;
    }

    function offCycleAnswer(needle) {
      if (needle.length < 3) return null;
      return offCycle.offices.find(
        (o) => o.toLowerCase().includes(needle) || needle.includes(o.toLowerCase().split(' (')[0]),
      );
    }

    function apply() {
      let shown = 0;
      cards.forEach((c) => {
        const ok = matches(c);
        c.hidden = !ok;
        if (ok) shown++;
      });

      // Hide a level heading whose races are all filtered out.
      document.querySelectorAll('[data-level-group]').forEach((s) => {
        s.hidden = ![...s.querySelectorAll('[data-race]')].some((c) => !c.hidden);
      });

      const anyFilter = Object.values(active).some((s) => s.size) || q.value.trim();
      clearBtn.hidden = !anyFilter;
      resultLine.textContent = shown === cards.length
        ? `Showing all ${cards.length} races`
        : `Showing ${shown} of ${cards.length} races`;

      empty.hidden = shown > 0;
      if (!shown) {
        const hit = offCycleAnswer(q.value.trim().toLowerCase());
        document.getElementById('empty-specific').hidden = !hit;
        document.getElementById('empty-generic').hidden = !!hit;   // never both
        if (hit) {
          document.getElementById('empty-heading').textContent = `${hit} has no 2026 election`;
          document.getElementById('empty-note').textContent = offCycle.note;
        }
      }
    }

    q.addEventListener('input', apply);
    groups.forEach((g) => g.addEventListener('click', (e) => {
      const btn = e.target.closest('.chip');
      if (!btn) return;
      const set = active[g.dataset.filterGroup];
      const on = btn.getAttribute('aria-pressed') === 'true';
      btn.setAttribute('aria-pressed', String(!on));
      on ? set.delete(btn.dataset.value) : set.add(btn.dataset.value);
      apply();
    }));
    clearBtn.addEventListener('click', () => {
      q.value = '';
      Object.values(active).forEach((s) => s.clear());
      document.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
      apply();
    });
  </script>
</Base>
