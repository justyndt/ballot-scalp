---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import RaceCard from '../components/RaceCard.astro';
import { meta, regions } from '../lib/meta';
import { LEVELS, PARTIES } from '../content.config';
import { activeCandidates, deadlineState, formatShort } from '../lib/derive';
import { jsonIsland } from '../lib/embed';

const entries = await getCollection('races');
const totalCandidates = entries.reduce((n, e) => n + e.data.candidates.length, 0);

const byLevel = LEVELS
  .map((level) => ({ level, races: entries.filter((e) => e.data.level === level) }))
  .filter((g) => g.races.length);

const primary = deadlineState(meta.elections.primary.date);

const partiesPresent = new Set(
  entries.flatMap((e) => activeCandidates(e.data).map((c) => c.party ?? 'Not stated')),
);
const partyOptions = [
  ...PARTIES.filter((p) => partiesPresent.has(p)),
  ...(partiesPresent.has('Not stated') ? ['Not stated'] : []),
];

const filterGroups = [
  { id: 'county', label: 'County', options: regions.map((r) => r.id) },
  { id: 'level', label: 'Race level', options: byLevel.map((g) => g.level) },
  { id: 'party', label: 'Party', options: partyOptions },
];
---
<Base title="Every race on your ballot">
  <div class="shell">
    <div
      class="grid items-end gap-x-16 gap-y-10"
      style="grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));padding:clamp(32px,6vw,56px) 0 40px"
    >
      <div>
        <p class="mb-4 text-label font-semibold tracking-[0.01em] text-accent-700">{meta.kicker}</p>
        <h1 class="mb-5 max-w-[16ch] text-hero">Everyone on your ballot. Nothing else.</h1>
        <p class="max-w-[52ch] text-intro">{meta.intro}</p>
      </div>

      <div class="pt-5" style="border-top:2px solid var(--color-divider)">
        <div class="grid grid-cols-2 gap-x-6" style="row-gap:2px">
          <div class="pb-4">
            <div class="muted mb-1.5 text-micro">{meta.elections.primary.label}</div>
            <div class="font-heading text-stat font-extrabold">{meta.elections.primary.short}</div>
            <div
              class="mt-[5px] text-meta font-semibold text-accent-700"
              id="primary-status"
              data-date={meta.elections.primary.date}
            >{primary.label}</div>
          </div>
          <div class="pb-4">
            <div class="muted mb-1.5 text-micro">{meta.elections.general.label}</div>
            <div class="font-heading text-stat font-extrabold">{meta.elections.general.short}</div>
            <div class="muted mt-[5px] text-meta">{meta.elections.general.note}</div>
          </div>
          <div class="pt-3.5" style="border-top:1px solid var(--color-divider)">
            <div class="muted mb-1 text-micro">{meta.elections.earlyVoting.label}</div>
            <div class="text-[14px] font-semibold">{meta.elections.earlyVoting.short}</div>
          </div>
          <div class="pt-3.5" style="border-top:1px solid var(--color-divider)">
            <div class="muted mb-1 text-micro">On this page</div>
            <div class="text-[14px] font-semibold">{entries.length} races · {totalCandidates} candidates</div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap">
      <aside
        class="min-w-0 flex-[1_1_236px]"
        style="border-right:2px solid var(--color-divider);padding:28px 28px 40px 0"
        aria-label="Filters"
      >
        <div class="sticky flex flex-col gap-[26px]" style="top:96px">
          <div class="flex items-baseline justify-between gap-2">
            <h2 class="text-label font-normal tracking-[0.01em]">Filter</h2>
            <button
              type="button"
              id="clear-filters"
              hidden
              class="cursor-pointer border-0 bg-transparent p-0 text-label font-semibold text-accent-700 underline"
              style="text-underline-offset:3px"
            >Clear all</button>
          </div>
          {filterGroups.map((g) => (
            <div class="flex flex-col gap-[9px]" data-filter-group={g.id}>
              <div class="muted text-micro">{g.label}</div>
              <div class="flex flex-wrap gap-1.5">
                {g.options.map((o) => (
                  <button type="button" class="chip" aria-pressed="false" data-value={o}>{o}</button>
                ))}
              </div>
            </div>
          ))}
          <div class="pt-4" style="border-top:2px solid var(--color-divider)">
            <p class="muted text-label leading-[1.5]">
              Candidates are listed alphabetically by last name in every race, always.
            </p>
          </div>
        </div>
      </aside>

      <div class="min-w-0 flex-[999_1_440px]" style="padding:28px 0 40px clamp(16px,3vw,32px)">
        <div class="relative flex items-center">
          <Icon
            name="lucide:search"
            width={18} height={18}
            class="pointer-events-none absolute left-3.5"
            style="color:color-mix(in srgb,var(--color-ink) 55%,transparent)"
            aria-hidden="true"
          />
          <input
            type="search" id="q"
            aria-label="Search races and candidates"
            placeholder="Search a name, an office, a district…"
            class="search-field w-full border-2 bg-transparent py-2 pl-[42px] pr-3.5 text-[16px]"
            style="min-height:48px;border-color:var(--color-accent)"
          />
        </div>

        <div
          class="flex items-baseline justify-between gap-4"
          style="padding:14px 0 16px;border-bottom:2px solid var(--color-divider)"
        >
          <span id="result-line" role="status" aria-live="polite" class="muted text-meta">Showing all {entries.length} races</span>
          <span class="muted text-label tracking-[0.01em]">Verified {formatShort(meta.lastVerified)}</span>
        </div>

        {byLevel.map((g) => (
          <section data-level-group={g.level}>
            <h2 class="mt-8 pb-2.5 text-label tracking-[0.01em] text-accent-700">{g.level}</h2>
            <div>
              {g.races.map((race) => <RaceCard race={race} />)}
            </div>
          </section>
        ))}

        <div id="empty" hidden class="py-12">
          <p id="empty-specific" hidden class="max-w-[46ch]">
            <strong id="empty-heading" class="block text-section"></strong>
            <span id="empty-note" class="mt-3 block text-body text-neutral-800"></span>
          </p>
          <p id="empty-generic" class="text-body text-neutral-800">No races match those filters.</p>
        </div>
      </div>
    </div>
  </div>

  <script
    is:inline
    type="application/json"
    id="off-cycle"
    set:html={jsonIsland({ ...meta.notUpThisCycle, cycle: meta.cycle })}
  />

  <script>
    import { deadlineState } from '../lib/clock';
    import { offCycleAnswer, type OffCycle } from '../lib/search';

    const primaryEl = document.getElementById('primary-status');
    const primaryDate = primaryEl?.getAttribute('data-date');
    if (primaryEl && primaryDate) primaryEl.textContent = deadlineState(primaryDate).label;

    const q = document.getElementById('q') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-race]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-group]'));
    const resultLine = document.getElementById('result-line');
    const clearBtn = document.getElementById('clear-filters');
    const empty = document.getElementById('empty');
    const offCycle = JSON.parse(
      document.getElementById('off-cycle')?.textContent || '{"offices":[],"note":"","cycle":""}',
    ) as OffCycle;

    const active = new Map<string, Set<string>>();
    groups.forEach((g) => active.set(g.getAttribute('data-filter-group') || '', new Set()));

    const query = () => (q?.value || '').trim();

    function matches(card: HTMLElement): boolean {
      const needle = query().toLowerCase();
      if (needle && !(card.getAttribute('data-search') || '').includes(needle)) return false;
      for (const [id, set] of active) {
        if (!set.size) continue;
        const field =
          id === 'county' ? (card.getAttribute('data-counties') || '').split('|')
          : id === 'level' ? [card.getAttribute('data-level') || '']
          : (card.getAttribute('data-parties') || '').split('|');
        if (![...set].some((v) => field.includes(v))) return false;
      }
      return true;
    }

    function apply() {
      let shown = 0;
      cards.forEach((c) => {
        const ok = matches(c);
        c.hidden = !ok;
        if (ok) shown++;
      });

      document.querySelectorAll<HTMLElement>('[data-level-group]').forEach((s) => {
        s.hidden = !Array.from(s.querySelectorAll<HTMLElement>('[data-race]')).some((c) => !c.hidden);
      });

      const anyFilter = [...active.values()].some((s) => s.size) || !!query();
      if (clearBtn) clearBtn.hidden = !anyFilter;
      if (resultLine) {
        resultLine.textContent = shown === cards.length
          ? `Showing all ${cards.length} races`
          : `Showing ${shown} of ${cards.length} races`;
      }

      if (empty) empty.hidden = shown > 0;
      if (!shown) {
        const hit = offCycleAnswer(query(), offCycle);
        const specific = document.getElementById('empty-specific');
        const generic = document.getElementById('empty-generic');
        if (specific) specific.hidden = !hit;
        if (generic) generic.hidden = !!hit;
        const heading = document.getElementById('empty-heading');
        const note = document.getElementById('empty-note');
        if (hit && heading && note) {
          heading.textContent = hit.heading;
          note.textContent = hit.note;
        }
      }
    }

    q?.addEventListener('input', apply);
    groups.forEach((g) => g.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.chip');
      if (!btn) return;
      const set = active.get(g.getAttribute('data-filter-group') || '');
      if (!set) return;
      const on = btn.getAttribute('aria-pressed') === 'true';
      btn.setAttribute('aria-pressed', String(!on));
      const value = btn.getAttribute('data-value') || '';
      if (on) set.delete(value);
      else set.add(value);
      apply();
    }));
    clearBtn?.addEventListener('click', () => {
      if (q) q.value = '';
      active.forEach((s) => s.clear());
      document.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
      apply();
    });
  </script>
</Base>
