---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { meta, calendar, regions } from '../lib/meta';
import { deadlineState } from '../lib/clock';

const steps = calendar.map((c) => ({ ...c, state: deadlineState(c.iso, c.isoEnd) }));

const nextIndex = steps.findIndex((s) => s.state.kind !== 'passed');

const toneOf = (i: number) =>
  steps[i].state.kind === 'passed' ? 'passed' : i === nextIndex ? 'next' : 'upcoming';
---
<Base title="Key dates and how to vote" description={meta.datesIntro}>
  <div class="shell">
    <header class="pb-8 pt-14" style="border-bottom:2px solid var(--color-divider)">
      <h1 class="mb-3.5 max-w-[18ch] text-title">Key dates and how to vote</h1>
      <p class="max-w-[56ch] text-intro">{meta.datesIntro}</p>
    </header>

    <section class="pb-11 pt-9" style="border-bottom:2px solid var(--color-divider)">
      <h2 class="mb-[18px] text-label font-normal tracking-[0.01em]">The sequence</h2>

      <div class="overflow-hidden">
        <ol
          class="grid list-none p-0"
          style="grid-template-columns:repeat(auto-fit,minmax(210px,1fr));width:calc(100% + 48px);margin-left:-24px"
        >

          {steps.map((s, i) => (
            <li
              class="flex flex-col pb-1"
              data-step
              data-iso={s.iso}
              data-iso-end={s.isoEnd ?? ''}
              data-tone={toneOf(i)}
              aria-current={i === nextIndex ? 'step' : undefined}
            >
              <div class="step-bar"></div>
              <div class="flex flex-1 flex-col px-6 pt-[30px]">
                <div class="mb-3 flex min-h-[17px] flex-wrap items-baseline gap-2">

                  <span class="step-status text-micro font-semibold tracking-[0.01em]" data-step-status>{s.state.label}</span>
                </div>

                <div
                  class="step-date mb-1.5 font-heading font-extrabold"
                  style="font-size:clamp(26px,2.4vw,32px);line-height:1;letter-spacing:-0.025em"
                >{s.date}</div>
                <div class="step-label mb-3 text-meta font-semibold leading-[1.3]">{s.label}</div>
                <p class="step-body max-w-[30ch] text-value">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section
      class="grid gap-x-14 gap-y-11 py-11"
      style="grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))"
    >

      <div>
        <h2 class="mb-5 text-label font-normal tracking-[0.01em]">{meta.explainer.heading}</h2>
        {meta.explainer.paras.map((p: string) => (
          <p class="mb-3.5 text-body">{p}</p>
        ))}
      </div>

      <div>
        <h2 class="mb-5 text-label font-normal tracking-[0.01em]">Your elections office</h2>
        <div class="grid gap-7" style="grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr))">
          {regions.map((o) => (
            <div class="pt-4" style="border-top:2px solid var(--color-divider)">
              <div class="mb-1 font-heading text-[18px] font-extrabold tracking-[-0.02em]">{o.name}</div>
              <div class="muted mb-3 text-meta leading-[1.45]">{o.supervisor}</div>
              <div class="mb-2.5 text-meta leading-[1.6]">{o.address}</div>
              <div class="mb-2.5 text-meta font-semibold">{o.phone}</div>
              <a href={o.url} target="_blank" rel="noopener" class="text-meta font-semibold">
                {o.domain}<span class="whitespace-nowrap"><Icon name="lucide:arrow-up-right" width={13} height={13} class="out-arrow" /></span>
              </a>
            </div>
          ))}
        </div>

        <div class="mt-8 pt-4" style="border-top:2px solid var(--color-divider)">
          <h3 class="mb-2.5 text-label font-normal tracking-[0.01em]">Not on the {meta.cycle} ballot</h3>
          <p class="muted mb-3 text-value leading-[1.55]">{meta.notUpThisCycle.note}</p>
          <div class="flex flex-wrap gap-1.5">
            {meta.notUpThisCycle.offices.map((o: string) => (
              <span class="muted text-label" style="padding:4px 9px;border:1px solid var(--color-divider)">{o}</span>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>

  li[data-step] {
    --dim: color-mix(in srgb, var(--color-ink) 45%, transparent);
    --soft: color-mix(in srgb, var(--color-ink) 70%, transparent);
  }
  li[data-tone='passed'] {
    --bar: var(--dim); --status: var(--dim); --date: var(--dim);
    --step-label: var(--dim); --body: var(--dim);
  }
  li[data-tone='next'] {
    --bar: var(--color-accent); --status: var(--color-accent-700); --date: var(--color-accent-700);
    --step-label: var(--color-ink); --body: var(--soft);
  }
  li[data-tone='upcoming'] {
    --bar: color-mix(in srgb, var(--color-ink) 18%, transparent); --status: var(--soft); --date: var(--color-ink);
    --step-label: var(--color-ink); --body: var(--soft);
  }
  .step-bar { height: 8px; background: var(--bar); }
  .step-status { color: var(--status); }
  .step-date { color: var(--date); }
  .step-label { color: var(--step-label); }
  .step-body { color: var(--body); }
</style>

<script>
  import { deadlineState } from '../lib/clock';

  const els = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
  const states = els.map((el) =>
    deadlineState(el.getAttribute('data-iso') || '', el.getAttribute('data-iso-end') || undefined),
  );
  const next = states.findIndex((s) => s.kind !== 'passed');

  els.forEach((el, i) => {
    el.setAttribute('data-tone', states[i].kind === 'passed' ? 'passed' : i === next ? 'next' : 'upcoming');
    if (i === next) el.setAttribute('aria-current', 'step');
    else el.removeAttribute('aria-current');
    const status = el.querySelector<HTMLElement>('[data-step-status]');
    if (status) status.textContent = states[i].label;
  });
</script>
