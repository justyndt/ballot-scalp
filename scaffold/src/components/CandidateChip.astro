---
import type { Candidate } from '../content.config';
import { partyAbbr, partyRuleClass, initials } from '../lib/derive';

interface Props { candidate: Candidate }
const { candidate: c } = Astro.props;
---

<span class={`cand-chip ${partyRuleClass(c.party)}`}>
  <span class="mono size-[26px] text-[10px]" aria-hidden="true">{initials(c.name)}</span>
  <span class="whitespace-nowrap text-meta font-semibold">{c.name}</span>

  <span class="muted whitespace-nowrap text-micro">{partyAbbr(c.party)}</span>
</span>
