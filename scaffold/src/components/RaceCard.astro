---
import type { CollectionEntry } from 'astro:content';
import CandidateChip from './CandidateChip.astro';
import {
  activeCandidates, seatParts, fieldLabel, electionLabel, orElse, NOT_PUBLISHED,
} from '../lib/derive';

interface Props { race: CollectionEntry<'races'> }
const { race } = Astro.props;
const r = race.data;
const candidates = activeCandidates(r);
const seat = seatParts(r.seat);
---

<a href={`/race/${race.id}`} class="race-row block py-5 no-underline" data-race
  data-county={r.county}
  data-counties={r.counties.join('|')}
  data-level={r.level}
  data-parties={[...new Set(candidates.map((c) => c.party ?? 'Not stated'))].join('|')}
  data-date={r.electionDate}
  data-district={r.districtNumber ?? ''}
  data-search={[r.office, r.seat, r.jurisdiction, r.county, r.level, r.heldBy.name,
                ...candidates.flatMap((c) => [c.name, c.party ?? ''])].join(' ').toLowerCase()}
>

  <div
    class="grid items-start gap-x-7 gap-y-[18px]"
    style="grid-template-columns:repeat(auto-fit,minmax(min(190px,100%),1fr))"
  >
    <div class="min-w-0">
      <div class="mb-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
        <span class="font-heading text-[20px] font-extrabold leading-[1.2] tracking-[-0.02em] text-ink">{r.office}</span>

        {seat.has && !seat.plain && (
          <span class="seat-sm">
            <span class="muted text-micro">{seat.word}</span>
            <span class="font-heading text-[15px] font-extrabold tracking-[-0.01em]">{seat.num}</span>
          </span>
        )}
        {seat.has && seat.plain && (
          <span class="seat-sm muted text-micro leading-[1.3]" style="padding:3px 8px">{seat.label}</span>
        )}
      </div>
      <div class="muted text-meta">{r.jurisdiction}</div>
    </div>

    <div class="min-w-0">
      <div class="muted mb-1 text-micro">Currently held by</div>
      <div class="text-[14px] font-semibold leading-[1.3]">{orElse(r.heldBy.name, NOT_PUBLISHED)}</div>

      {r.heldBy.note && (
        <div class="mt-[3px] text-label leading-[1.35] text-accent-700">{r.heldBy.note}</div>
      )}
    </div>

    <div class="flex flex-col items-start gap-[7px]">
      <span class="text-micro font-bold tracking-[0.01em]" style="padding:4px 8px;border:1px solid var(--color-divider)">{fieldLabel(r)}</span>
      <span class="muted text-label">{electionLabel(r)}</span>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    {candidates.map((c) => <CandidateChip candidate={c} />)}

    {candidates.length === 0 && (
      <span class="muted text-meta italic">
        {r.pending ? 'Roster not yet published' : 'Nobody qualified for this seat'}
      </span>
    )}
  </div>
</a>
