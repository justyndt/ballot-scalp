---
import '../styles/global.css';
import { meta } from '../lib/meta';

interface Props { title: string; description?: string }
const { title, description = meta.intro } = Astro.props;
const nav = [
  { href: '/', label: 'Races' },
  { href: '/ballot', label: 'My ballot' },
  { href: '/compare', label: 'Compare' },
  { href: '/dates', label: 'Key dates' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {meta.name}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>

    <header class="rule" style="border-top:0;border-bottom:2px solid var(--color-divider)">
      <div class="shell flex flex-wrap items-center justify-between gap-4 py-4">
        <a href="/" class="flex items-center gap-3 no-underline">
          <span class="block size-8 bg-accent" aria-hidden="true"></span>
          <span>
            <span class="block font-heading text-[17px] font-extrabold tracking-[-0.02em] text-ink">{meta.name}</span>
            <span class="block text-label text-neutral-700">{meta.scope}</span>
          </span>
        </a>
        <nav class="flex flex-wrap gap-6" aria-label="Sections">
          {nav.map((n) => {
            const on = n.href === '/' ? path === '/' || path.startsWith('/race') : path.startsWith(n.href);
            return (
              <a
                href={n.href}
                aria-current={on ? 'page' : undefined}
                class="text-meta font-semibold no-underline"
                style={on
                  ? 'color:var(--color-accent);box-shadow:inset 0 -3px 0 var(--color-accent);padding-bottom:6px'
                  : 'color:var(--color-ink)'}
              >{n.label}</a>
            );
          })}
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <!-- Footer carries the disclaimer, sources, known gaps and the photo note.
         All of it comes from meta — see README § Screens. -->
    <slot name="footer" />
  </body>
</html>
